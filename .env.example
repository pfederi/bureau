# Bureau – Umgebungsvariablen. Kopieren nach .env.local und ausfüllen. Nie committen.

# Pflicht: Supabase (Projekt-Einstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pflicht: öffentliche Adresse der App (Links in Mails, Kundenportal)
APP_URL=https://admin.example.ch

# Pflicht für Cron-Jobs (Wochenmail, Website-Überwachung): zufällig, mind. 16 Zeichen
CRON_SECRET=

# Optional: Mailversand über Resend (Rechnungen, Erinnerungen, Wochenmail, Alarm)
RESEND_API_KEY=
# Optional: überschreibt den Absender aus den Einstellungen: "Vorname Name <rechnung@example.ch>"
INVOICE_FROM_EMAIL=

# Optional: Belege automatisch auslesen (Groq)
GROQ_API_KEY=
GROQ_MODEL=
